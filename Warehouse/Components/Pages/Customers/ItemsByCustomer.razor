@code {
    private List<InventoryItem> inventory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerInventory();
    }

    private async Task LoadCustomerInventory()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated == true)
        {
            var email = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value;
            if (!string.IsNullOrEmpty(email))
            {
                var customer = await DataService.GetCustomerByEmailAsync(email);
                if (customer != null)
                {
                    inventory = await DataService.GetInventoryByCustomerIdAsync(customer.Id);
                }
            }
        }
    }

    private void ViewItemDetails(int itemId)
    {
        NavigationManager.NavigateTo($"/dashboard/customer/item/{itemId}");
    }
} *@
