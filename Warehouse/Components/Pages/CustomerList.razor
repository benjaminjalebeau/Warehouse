@page "/dashboard/customers"
@using Warehouse.Components.Layout
@layout DashboardLayout
@using Warehouse.Components
@using Warehouse.Data;
@using Warehouse.Models;
@inject DataService DataService
@rendermode RenderMode.InteractiveServer

<PageTitle>Customer List</PageTitle>

<AuthorizeView Roles="Worker">
    <Authorized>
<h1>Customers</h1>

@if (PagedCustomers.Count == 0)
{
    <p><em>There are no workers available yet to show.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th aria-label="Name">Name</th>
                <th aria-label="Email">Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in PagedCustomers)
            {
                <tr>
                    <td>@customer.Id</td>
                    <td>@customer.FirstName @customer.LastName</td>
                    <td>@customer.Email</td>
                    <td>
                        <NavLink class="btn btn-secondary" href="@($"/dashboard/customer/items/{customer.Id}")">View Items</NavLink>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <button @onclick="PreviousPage" disabled="@(!CanGoPrevious)">⏪ Previous</button>
        <span> Page @CurrentPage of @TotalPages </span>
        <button @onclick="NextPage" disabled="@(!CanGoNext)">Next ⏩</button>
    </div>
}

    </Authorized>
    <NotAuthorized>
        <p>You are not authorized to view this page.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<Customer> customers = new();
    private List<Customer> PagedCustomers = new();
    private int CurrentPage { get; set; } = 1;
    private int TotalPages { get; set; }
    private const int PageSize = 10; // Número de trabajadores por página

    // Propiedades que determinan si se puede ir a la siguiente o anterior página
    private bool CanGoNext => CurrentPage < TotalPages;
    private bool CanGoPrevious => CurrentPage > 1;

    // Método que se llama al inicializar el componente
    protected override async Task OnInitializedAsync()
    {
        customers = await DataService.GetCustomersAsync() ?? new List<Customer>();
        TotalPages = (int)Math.Ceiling((double)customers.Count / PageSize);
        LoadPage(CurrentPage);
    }

    // Método para cargar la página actual
    private void LoadPage(int pageNumber)
    {
        PagedCustomers = customers.Skip((pageNumber - 1) * PageSize).Take(PageSize).ToList();
        StateHasChanged(); // Fuerza la actualización de la UI
    }

    // Método para pasar a la siguiente página
    private void NextPage()
    {
        if (CanGoNext)
        {
            CurrentPage++;
            LoadPage(CurrentPage);
        }
    }

    // Método para pasar a la página anterior
    private void PreviousPage()
    {
        if (CanGoPrevious)
        {
            CurrentPage--;
            LoadPage(CurrentPage);
        }
    }
}

