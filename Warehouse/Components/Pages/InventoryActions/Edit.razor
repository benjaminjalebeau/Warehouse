@page "/dashboard/inventory/edit"
@using Warehouse.Components.Layout
@layout DashboardLayout
@using Microsoft.EntityFrameworkCore
@using Warehouse.Data;
@using Warehouse.Models;
@inject DataService DataService
@rendermode InteractiveServer
@inject NavigationManager NavigationManager


<PageTitle>Edit Item</PageTitle>

<h1>Edit an inventory Item</h1>

<h2>@Item.Name</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Item" OnValidSubmit="SaveInventory">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="Item.Name" class="form-control" />
                <ValidationMessage For="() => Item.Name" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="weight" class="form-label">weight:</label>
                <InputNumber id="weight" @bind-Value="Item.Weight" class="form-control"
                    placeholder="Weight of Item in KG" />
                <ValidationMessage For="() => Item.Weight" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description:</label>
                <InputText id="description" @bind-Value="Item.Description" class="form-control"
                    placeholder="Description of Item" />
                <ValidationMessage For="() => Item.Description" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="receiveDate" class="form-label">Receive Date:</label>
                <InputDate id="receiveDate" @bind-Value="Item.ReceivedDate" class="form-control" />
                <ValidationMessage For="() => Item.ReceivedDate" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">Location:</label>
                <InputText id="location" class="form-control" @bind-Value="Item.LocationId" />
                <ValidationMessage For="() => Item.LocationId" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="customerid" class="form-label">Customer Id:</label>
                <InputNumber id="customerid" @bind-Value="Item.CustomerId" class="form-control"
                    placeholder="Example: 3" />
                <ValidationMessage For="() => Item.CustomerId" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <NavLink href="/dashboard/inventory"><span class="my-3 btn btn-outline-info">Back to Inventory</span></NavLink>
</div>


@code {

    private InventoryItem Item = new InventoryItem
    {
        Name = string.Empty,
        Weight = 0.1,
        CustomerId = 1,
        ReceivedDate = DateTime.Today,
        Description = "This is a description"
    };


    private async Task SaveInventory()
    {
        try
        {
            await DataService.AddInventoryItemAsync(Item);
            // force the UI to refresh
            StateHasChanged();

            // Redirect the user to dashboard/inventory route one the item is created
            NavigationManager.NavigateTo("/dashboard/inventory");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving inventory: {ex.Message}");
            
        }
    }



}
