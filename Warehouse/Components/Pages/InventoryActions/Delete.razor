@page "/dashboard/inventory/delete/{id:int}"
@using Warehouse.Components.Layout
@layout DashboardLayout
@using Microsoft.EntityFrameworkCore
@using Warehouse.Data;
@using Warehouse.Models;
@inject DataService DataService
@rendermode InteractiveServer
@inject NavigationManager NavigationManager


<PageTitle>Delete Item</PageTitle>

<h1>Are you sure you want to delete this item?</h1>

@if (!isDeleted) // check if the variable is true or false. if false, show the form
{
    @if (inventoryItem is not null) // check if the inventoryItem is not null, if not, show the form
    {
        <h2>@inventoryItem.Name</h2>

        <hr />
        <div class="row">
            <div class="col-md-4">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Name:</label>
                        <input class="form-control" value="@inventoryItem.Name" disabled /> 
                        @* disabled in the input form deny the edition *@
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Weight:</label>
                        <input class="form-control" value="@inventoryItem.Weight" disabled /> 
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description:</label>
                        <textarea class="form-control" disabled>@inventoryItem.Description</textarea>
                    </div>
                    <button type="button" class="btn btn-danger" @onclick="DeleteItem">Delete</button>
                    <NavLink class="btn btn-secondary" href="/dashboard/inventory">Cancel</NavLink>
                </form>
            </div>
        </div>

        <div>
            <NavLink href="/dashboard/inventory"><span class="my-3 btn btn-outline-info">Back to Inventory</span></NavLink>
        </div>
    }
    else
    {
        <p>Loading...</p>
    }
}
else // if the item is deleted, show the success message
{
    <p class="text-success">✅ Deleted successfully! Redirecting...</p>
}




@code {
    [Parameter]
    public int Id { get; set; }
    private InventoryItem? inventoryItem;

    private bool isDeleted = false; // will change to Trrue once the DeleteItem task is operated

    protected override async Task OnInitializedAsync()
    {
        inventoryItem = await DataService.GetInventoryItemByIdAsync(Id);
    }


    private async Task DeleteItem()
    {
        try
        {
            if (inventoryItem is not null)
            {
                await DataService.DeleteInventoryItemAsync(inventoryItem.Id);
                isDeleted = true; // now, the ""Success" <p> will be shown
                StateHasChanged(); // this is to force the UI refresh

                await Task.Delay(2000); // a delay of 2 seconds so the user can see the success message

                NavigationManager.NavigateTo("/dashboard/inventory");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting inventory: {ex.Message}");

        }
    }



}
