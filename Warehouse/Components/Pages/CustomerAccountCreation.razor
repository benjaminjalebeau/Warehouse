@page "/CustomerAccountCreation"
@using Warehouse.Data;
@using Warehouse.Models;
@using System.ComponentModel.DataAnnotations
@inject DataService DataService
@rendermode InteractiveServer

<PageTitle>Customer Account Creation</PageTitle>

<div class="AccountCreationPage">
<h1>Customer Account Creation</h1>

<p>Please fill out the form to create a customer account.</p>
<hr />
 <div class="row">
        <div class="col-md-4">
        <EditForm Model="@newCustomer" OnValidSubmit="@(SaveCustomer)" FormName="CreateCustomerAccountForm">
            <DataAnnotationsValidator/>
            @if(!string.IsNullOrEmpty(message))
            {
                <div class="alert">@message</div>
            }

            <div class="mb-3">
                <label for="firstName" class="form-label">First Name:</label>
                <InputText id="firstName" @bind-Value="newCustomer.FirstName" class="form-control" placeholder="ex: John"/>
                <ValidationMessage For="@(() => newCustomer.FirstName)" class="text-danger"/>
            </div>
            <div class="mb-3">
                <label for="lastName" class="form-label">Last Name:</label>
                <InputText id="lastName" @bind-Value="newCustomer.LastName" class="form-control" placeholder="ex: Doe"/>
                <ValidationMessage For="@(() => newCustomer.LastName)"  class="text-danger"/>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <InputText id="email" @bind-Value="newCustomer.Email" type="email" class="form-control" placeholder="ex: test@example.com"/>
                <ValidationMessage For="@(() => newCustomer.Email)"  class="text-danger"/>
            </div>
            
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <InputText id="password" @bind-Value="newCustomer.Password" type="password" class="form-control" placeholder="ex: password"/>
                <ValidationMessage For="@(() => newCustomer.Password)"  class="text-danger"/>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            
        </EditForm>
        </div>
    </div>

    @if (isUpdated)
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</div>

@code 
{
    private bool isUpdated = false;

    private string? successMessage;
    private string? message;
    private Customer newCustomer = new Customer{
        FirstName = string.Empty,
        LastName = string.Empty,
        Email = string.Empty,
        Password = string.Empty
    };

    private async Task SaveCustomer()
    {
        var checkEmail = await DataService.IsEmailTakenAsync(newCustomer.Email);

        if(checkEmail)
        {
            message = "Email is already in use.";
        }
        else 
        {
            if (newCustomer.Id == 0)
            {
                await DataService.AddCustomerAsync(newCustomer);
                isUpdated = true;
                newCustomer = new Customer {
                    FirstName = string.Empty,
                    LastName = string.Empty,
                    Email = string.Empty,
                    Password = string.Empty
                };
                successMessage = "Account Created! Please Login";
                StateHasChanged();
            }
            else
            {
                message = "Something went wrong.";
            }
        }  
    }

    
}
