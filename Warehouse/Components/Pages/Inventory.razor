@page "/dashboard/inventory"
@using Warehouse.Components.Layout
@layout DashboardLayout
@using Warehouse.Data;
@using Warehouse.Models;
@inject DataService DataService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Warehouse Inventory</PageTitle>

<AuthorizeView Roles="Worker">
    <Authorized>
        <h3>Inventory </h3>
        @* Link for the create component *@
        <NavLink href="/dashboard/inventory/create"><span class="btn btn-success my-4">Create New Item</span></NavLink>

        <table class="table">
            <thead>
                <tr>
                    <th>Item Name</th>
                    <th>Weight(Kg)</th>
                    <th>Recieved Date</th>
                    <th>Location</th>
                    <th>Customer Name & ID</th>
                    <th>Actions</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in joinedItems)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Weight</td>
                        <td>@item.ReceivedDate</td>
                        <td>@item.LocationId</td>
                        <td>@item.CustomerName :@item.CustomerId</td>
                        <td>
                            <NavLink class="btn btn-secondary" href="@($"/dashboard/inventory/edit/{item.Id}")">Edit</NavLink>
                            <NavLink class="btn btn-danger" href="@($"/dashboard/inventory/delete/{item.Id}")">Delete</NavLink>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </Authorized>
    <NotAuthorized>
        <p>You are not authorized to view this page.</p>
    </NotAuthorized>
</AuthorizeView>



@code {

    public class ExtendedInventory : InventoryItem
    {
        public string CustomerName {get; set;} = string.Empty;

    }

    private List<InventoryItem> inventory = new();
    private List<Customer> customers = new();
    private List<ExtendedInventory> joinedItems = new();

    

    private InventoryItem newItem = new  InventoryItem{
        Name = "TestBox",
        Weight = 1.55F,
        CustomerId = 1,
        ReceivedDate = DateTime.Today,
        Description = "This is a test"
    };

    protected override async Task OnInitializedAsync()
    {
        inventory = await DataService.GetInventoryAsync();
        customers = await DataService.GetCustomersAsync();

        var result = from item in inventory
                        join customer in customers
                        on item.CustomerId equals customer.Id
                        select new ExtendedInventory
                        {
                            Name = item.Name,
                            Weight = item.Weight,
                            ReceivedDate = item.ReceivedDate,
                            LocationId = item.LocationId,
                            CustomerId = item.CustomerId,
                            CustomerName = customer.FirstName + " " + customer.LastName,
                            Id = item.Id
                        };
        joinedItems = result.ToList();
    }

    private async Task SaveInventory()
    {
        if (newItem.Id == 0)
            await DataService.AddInventoryItemAsync(newItem);
        else
            await DataService.UpdateInventoryItemAsync(newItem);

        newItem = new  InventoryItem
        {
            Name = "TestBox",
            Weight = 1.55,
            CustomerId = 1,
            ReceivedDate = DateTime.Today,
            Description = "This is a test"
        };
        inventory = await DataService.GetInventoryAsync();
    }

    private void EditInventory(InventoryItem item)
    {
        newItem = new InventoryItem 
        { 
            Id = item.Id, 
            Name = item.Name, 
            Description = item.Description, 
            CustomerId = item.CustomerId,
            ReceivedDate = item.ReceivedDate,
            Weight = item.Weight,
            LocationId = item.LocationId,
            ShippedDate = item.ShippedDate
        };
    }

    private async Task DeleteInventory(int id)
    {
        await DataService.DeleteInventoryItemAsync(id);
        inventory = await DataService.GetInventoryAsync();
    }
}
