@page "/WorkerAccountCreation"
@using Warehouse.Data;
@using Warehouse.Models;
@using System.ComponentModel.DataAnnotations
@inject DataService DataService
@rendermode InteractiveServer

<PageTitle>Add Worker</PageTitle>
<div id="AddWorkerPage">
<h3>Worker Account Creation</h3>

<p>Please fill out the form to create a worker account.</p>

<EditForm Model="@newWorker" OnValidSubmit="@(SaveWorker)" FormName="CreateWorkerAccountForm">
    <DataAnnotationsValidator/>
    @if(!string.IsNullOrEmpty(message))
    {
        <div class="alert">@message</div>
    }

    <div>
        <label>Full Name:</label>
        <InputText @bind-Value="newWorker.Name" placeholder="ex: John Doe"/>
        <ValidationMessage For="@(() => newWorker.Name)" />
    </div>
    <div>
        <label>Email:</label>
        <InputText @bind-Value="newWorker.Email" type="email" placeholder="ex: test@example.com"/>
        <ValidationMessage For="@(() => newWorker.Email)" />
    </div>
    
    <div>
        <label>Password</label>
        <InputText @bind-Value="newWorker.Password" type="password" placeholder="ex: password"/>
        <ValidationMessage For="@(() => newWorker.Password)" />
    </div>

    <button type="submit">Submit</button>
    
</EditForm>
</div>


@code 
{
    private string? message;
    private Worker newWorker = new Worker{
        Name = string.Empty,
        Email = string.Empty,
        Password = string.Empty
    };

    private async Task SaveWorker()
    {
        var checkEmail = await DataService.IsEmailTakenAsync(newWorker.Email);

        if(checkEmail)
        {
            message = "Email is already in use.";
        }
        else 
        {
            if (newWorker.Id == 0)
            {
                await DataService.AddWorkerAsync(newWorker);
                message = "Account successfully created.";
                newWorker = new Worker {
                    Name = string.Empty,
                    Email = string.Empty,
                    Password = string.Empty
                };
                StateHasChanged();
            }
            else
            {
                message = "Something went wrong.";
            }
        }  
    }
}
