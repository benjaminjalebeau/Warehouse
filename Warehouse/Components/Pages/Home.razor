@page "/"
@using Warehouse.Components.Pages
@inject NavigationManager NaviagationManager

<PageTitle>Home</PageTitle>
<div class="main-container">
    <AuthorizeView Roles="Worker">
        <Authorized>
            <p class="alert alert-success mt-3">You're Logged In as a Worker! Select the Dashboard</p>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="Customer">
        <Authorized>
            <p class="alert alert-success mt-3">You're Logged In as a Customer! Select the Dashboard</p>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView>
        <NotAuthorized>
            <p class="alert alert-warning">Please Login</p>
        </NotAuthorized>
    </AuthorizeView>


    <div class="heading-container">
        <h1>Welcome to Warehouse Management App (WMA)</h1>
    </div>


    <section>
        <h2>Manage Your Inventory Efficiently</h2>

        <p>Warehouse Management App (WMA) is a solution designed to help warehouse workers and clients manage inventory
            quickly
            and efficiently. With our platform, you can maintain precise control over stored products, update
            information in
            real-time, and enhance the organization of your logistics operations.</p>

    </section>
    <section class="sec-two">

        <p>If you don’t have an account yet, sign up now and start optimizing your warehouse management.
            If you’re
            already a
            user, log in to access your inventory
        </p>
        <NavLink href="/customerAccountCreation"><span class="btn btn-primary">Join WMA</span></NavLink>

    </section>
    <div class="heading-container">
        <h2>What Can You Do with WMA?</h2>
    </div>
    <section class="sec-three">

        <div>
            <h3>For Warehouse Workers:</h3>

            <ul>
                <li>View and manage inventory in different warehouses
                </li>
                <li>Filter inventory by location and customers
                </li>
                <li>Add new products and update quantities
                </li>
                <li>Register and manage customers with their contact information and storage rates
                </li>
            </ul>
        </div>

        <div>
            <h3>For Clients:</h3>

            <ul>
                <li>Check stored products in real-time
                </li>
                <li>View specific details about their inventory and location
                </li>
            </ul>
        </div>

        <div>
            <h3>For All Users:</h3>

            <ul>
                <li>Access securely with authentication.
                </li>
                <li>Log out safely at any time
                </li>
            </ul>
        </div>
    </section>

    <section class="call-btns">
        <div>
            <NavLink href="/CustomerAccountCreation"><span class="btn btn-primary">Sign Up</span></NavLink>
            <NavLink href="/login"><span class="btn btn-secondary">Log In</span></NavLink>
        </div>
    </section>


</div>
