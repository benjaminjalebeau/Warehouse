@page "/login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@inject AuthService AuthService
@inject NavigationManager NavManager
<div class="loginContainer">
<h3>Login</h3>
    <AuthorizeView>
        <Authorized>
            <p>You're currently logged in</p>
        </Authorized>
        <NotAuthorized>
            <p>You're currently logged out</p>
        </NotAuthorized>
    </AuthorizeView>
<EditForm method="post" FormName="ClickLogin" OnSubmit="HandleLogin" Model="UserCredentials">

    <InputText @bind-Value="UserCredentials.Username" placeholder="Username"></InputText>
    <InputText @bind-Value="UserCredentials.Password" placeholder="Password" />

    <button type="submit" class="btn btn-primary"> SignIn</button>

</EditForm>
</div>

@code
{

    [SupplyParameterFromForm]
    public Credential UserCredentials { get; set; } = new Credential();
    public class Credential
    {
        public string? Username { get; set; }
        public string? Password { get; set; }
    }

    private async Task HandleLogin()
    {
        await AuthService.AuthenticateUserAsync(UserCredentials.Username, UserCredentials.Password);

        NavManager.NavigateTo("/");

    }
}
