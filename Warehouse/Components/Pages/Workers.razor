@* @page "/dashboard/workers"
@using Warehouse.Components.Layout
@layout DashboardLayout
@using Warehouse.Components
@using Warehouse.Data;
@using Warehouse.Models;
@inject DataService DataService

<PageTitle>Workers</PageTitle>

<h1>Workers</h1>

@if (PagedWorkers.Count == 0)
{
    <p><em>There are no workers available yet to show.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th aria-label="Name">Name</th>
                <th aria-label="Email">Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in PagedWorkers)
            {
                <tr>
                    <td>@worker.Id</td>
                    <td>@worker.Name</td>
                    <td>@worker.Email</td>
                </tr>
            }
        </tbody>
    </table>

    <Pagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" OnPageChanged="HandlePageChanged" />
}

@code {
    private List<Worker> workers = new();
    private List<Worker> PagedWorkers = new();
    private int CurrentPage = 1;
    private int PageSize = 2;
    private int TotalPages => (int)Math.Ceiling((double)workers.Count / PageSize);

    protected override async Task OnInitializedAsync()
    {
        workers = await DataService.GetWorkersAsync() ?? new List<Worker>();
        UpdatePagedWorkers();
    }

    private void UpdatePagedWorkers()
    {
        var skip = (CurrentPage - 1) * PageSize;
        PagedWorkers = workers.Skip(skip).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedWorkers();
        StateHasChanged();
    }
} *@
