@using Warehouse.Components
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject DataService DataService


<div>
    <nav id="sidebarMenu" class="collapse d-lg-block sidebar collapse bg-white">
        <div class="position-sticky">
            <div class="list-group list-group-flush mx-3 mt-4">
                @* sidebar / *@

                <NavLink href="/dashboard" class="dashboard-title list-group-item list-group-item-action py-2 ripple"
                    ActiveClass="active" Match="NavLinkMatch.All">
                    <i class="fas fa-chart-area fa-fw me-3"></i><span>Dashboard</span>
                </NavLink>

                <AuthorizeView Roles="Customer">
                    <Authorized>
                        <NavLink href="/dashboard/customers/items" class="list-group-item list-group-item-action py-2 ripple"
                            ActiveClass="active">
                            <i class="fas fa-chart-area fa-fw me-3"></i><span>Your Items</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Worker">
                    <Authorized>
                        <NavLink href="/dashboard/customers" class="list-group-item list-group-item-action py-2 ripple"
                            ActiveClass="active">
                            <i class="fas fa-chart-area fa-fw me-3"></i><span>Customers</span>
                        </NavLink>

                        <NavLink href="/dashboard/inventory" class="list-group-item list-group-item-action py-2 ripple"
                            ActiveClass="active">
                            <i class="fas fa-lock fa-fw me-3"></i><span>Inventory</span>
                        </NavLink>

                        <NavLink href="/dashboard/workers" class="list-group-item list-group-item-action py-2 ripple"
                            ActiveClass="active">
                            <i class="fas fa-lock fa-fw me-3"></i><span>Workers</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
                <NavLink href="/account/setting" class="list-group-item list-group-item-action py-2 ripple"
                    ActiveClass="active">
                    <i class="fas fa-chart-bar fa-fw me-3"></i><span>Account Settings</span>
                </NavLink>

            </div>
        </div>
    </nav>
</div>


